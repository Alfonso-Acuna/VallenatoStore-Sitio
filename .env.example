# VallenatoStore · Variables de Supabase
# En este sitio estático no hay bundler que lea .env en el navegador.
# Copia estos valores en config.js (SUPABASE_URL y SUPABASE_ANON_KEY).
# Si migras a Vite/Webpack, usa import.meta.env.VITE_SUPABASE_URL y
# import.meta.env.VITE_SUPABASE_ANON_KEY.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica
